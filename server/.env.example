# RemoDroid signaling server configuration.
# Copy to .env and adjust. Never commit .env. Every value below is optional unless stated.

# --- Runtime --------------------------------------------------------------
# development | production | test
NODE_ENV=development
# Interface and port the HTTP/WebSocket server binds to.
# Behind Cloudflare Tunnel or a reverse proxy on the same machine, prefer HOST=127.0.0.1.
HOST=0.0.0.0
PORT=8080
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Public URL clients use (informational; logged at startup). Clients are configured separately.
# Example: wss://signal.example.com/ws
PUBLIC_SIGNALING_URL=

# --- TLS -----------------------------------------------------------------
# Production traffic must be HTTPS/WSS. Either terminate TLS here...
TLS_CERT_FILE=
TLS_KEY_FILE=
# ...or terminate it at a proxy/tunnel and set TRUST_PROXY=true so client IPs come from
# CF-Connecting-IP / X-Forwarded-For (only enable when such a proxy is actually in front).
TRUST_PROXY=false

# Browser origins allowed to open a WebSocket (comma separated). Native clients send no Origin.
# Leave empty to refuse all browser origins.
ALLOWED_ORIGINS=

# --- ICE (STUN / TURN) ---------------------------------------------------
# Comma-separated STUN URLs. Set to an empty value to disable STUN.
STUN_URLS=stun:stun.l.google.com:19302
# Comma-separated TURN URLs, e.g.
# turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
TURN_URLS=
# Recommended: shared secret matching coturn's static-auth-secret (use-auth-secret).
# The server then issues short-lived TURN credentials per session.
TURN_SHARED_SECRET=
# Alternative for providers that issue fixed credentials (less secure: they do not expire).
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_CREDENTIAL_TTL_SECONDS=3600

# --- Sessions and authentication -----------------------------------------
# Lifetime of a temporary host password.
PASSWORD_TTL_SECONDS=3600
# Maximum lifetime of a host registration (temporary ID) before it must re-register.
HOST_REGISTRATION_TTL_SECONDS=43200
# How long the host has to approve an incoming request.
APPROVAL_TIMEOUT_SECONDS=60
# How long a dropped connection may take to resume before its session is ended.
RESUME_GRACE_SECONDS=30
# Hard limit on an approved session's duration.
SESSION_MAX_DURATION_SECONDS=28800
# WebSocket ping interval; connections that miss one full interval are dropped.
HEARTBEAT_INTERVAL_SECONDS=20

# Failed password attempts (per IP and per target ID) before a temporary lockout.
AUTH_MAX_FAILURES=5
AUTH_FAILURE_WINDOW_SECONDS=300
# First lockout duration; each further lockout doubles it, up to the maximum.
AUTH_LOCKOUT_BASE_SECONDS=30
AUTH_LOCKOUT_MAX_SECONDS=900

# --- Abuse limits --------------------------------------------------------
MAX_MESSAGE_BYTES=65536
MAX_CONNECTIONS_PER_IP=20
MESSAGES_PER_SECOND=50
MESSAGE_BURST=200

{
  "name": "remodroid-signaling-server",
  "version": "0.1.0",
  "private": true,
  "description": "RemoDroid WebSocket signaling server",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "start": "node --env-file-if-exists=.env dist/index.js"
  },
  "dependencies": {
    "pino": "10.4.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}

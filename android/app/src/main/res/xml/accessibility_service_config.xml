<?xml version="1.0" encoding="utf-8"?>
<!--
  canPerformGestures: required for remote taps/swipes (dispatchGesture).
  canRetrieveWindowContent: required only to find the focused text field for remote typing.
  No accessibility events are consumed; the service never reads or forwards screen content.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="1000"
    android:settingsActivity="com.remodroid.android.MainActivity" />
